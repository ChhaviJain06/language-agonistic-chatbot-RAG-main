{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "editor.formatOnSave": true,
  "[python]": { "editor.defaultFormatterProvider": "charliermarsh.ruff", "editor.defaultFormatter": "charliermarsh.ruff" },
  "ruff.lint.run": "onSave",
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true, "**/.ruff_cache": true },
  "search.exclude": { "web/node_modules": true, "web/dist": true, ".venv": true }
}
