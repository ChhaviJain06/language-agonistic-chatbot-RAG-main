# Copy to .env and fill in. .env is gitignored (C4).
# Everything below has a FREE option: free API tiers (Groq, Sarvam, Cohere) for the cloud
# profile, or fully open-source local models (Ollama, faster-whisper, bge-m3, Kokoro) for
# the onprem profile. Nothing here requires a paid plan.

BHASHA_PROFILE=cloud            # cloud | hybrid | onprem

# Provider selection. Ignored (forced local) when BHASHA_PROFILE=onprem.
ASR_EN_PROVIDER=groq             # groq | local
ASR_INDIC_PROVIDER=sarvam        # sarvam | local
LLM_PROVIDER=groq                # groq | ollama
LLM_MODEL=openai/gpt-oss-120b    # Groq model id
LLM_FALLBACK_MODEL=openai/gpt-oss-20b  # used when LLM_MODEL is rate-limited (own quota bucket); empty = off
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct # `ollama pull qwen2.5:7b-instruct` (free, open-source)
TTS_PROVIDER=sarvam              # sarvam | kokoro
SARVAM_TTS_STREAMING=true        # WebSocket streaming (first audio ~0.25 s); false = REST
SARVAM_SPEAKER=shubh             # Bulbul v3 voice, lowercase (shubh, ritu, priya, aditya, ...)
EMBED_PROVIDER=cohere            # cohere (free tier) | local (bge-m3)
RERANK_PROVIDER=cohere           # cohere (free tier) | local (bge-reranker-v2-m3)
# Optional translation (free, no key, via deep-translator). Forced to none for onprem: it sends
# text off-machine. Used as a script-repair fallback and, if TRANSLATE_QUERIES=true, for keyword search.
TRANSLATION_PROVIDER=auto        # auto | local | mymemory | google | none
                                 #  auto  = local IndicTrans2 if installed, else MyMemory, else none
                                 #  local = offline only (pip install -e ".[translate]" + download_models.py)
TRANSLATE_QUERIES=false          # true = also translate questions for keyword search (+~2 s/turn)
EMBED_DEVICE=cpu                 # cpu | cuda — only for the local bge models

# Free keys: https://console.groq.com  https://dashboard.sarvam.ai  https://dashboard.cohere.com
# Must be EMPTY when BHASHA_PROFILE=onprem — startup fails loudly otherwise.
GROQ_API_KEY=
SARVAM_API_KEY=
COHERE_API_KEY=

DATABASE_URL=postgresql+asyncpg://bhasha:bhasha@localhost:5432/bhasha
LIVEKIT_URL=ws://localhost:7880
# Address the BROWSER connects to (only needed when it differs from LIVEKIT_URL, e.g. Docker).
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_at_least_32_chars

VAD_SILENCE_MS=400
# Skip the rerank call for plain factoid questions (faster; measure recall with evaluate.py).
SKIP_RERANK_FACTOID=false
RETRIEVE_TOP_K=20
RERANK_TOP_K=5
RERANK_TIMEOUT_S=1.0
LLM_REASONING_EFFORT=low         # low | medium | high | default (gpt-oss models only; low = faster)
RERANK_CANDIDATES=12             # rerank only the top N fused chunks (12 ≈ -0.15 s, -1.5 pts Recall@5)
FIDELITY_SCRIPT_THRESHOLD=0.15   # foreign-script ratio that triggers repair

# --- API hardening ---------------------------------------------------------------
ACCESS_KEY=                      # optional: required as X-Access-Key on /livekit/token and /query*
# NOTE: a VITE_ACCESS_KEY baked into the web build is visible to anyone who opens the page.
MAX_QUESTION_CHARS=600
RATE_LIMIT_PER_MINUTE=30         # per client IP; 0 disables
MAX_CONCURRENT_AGENTS=5
AGENT_JOIN_TIMEOUT_S=60          # stop an agent nobody joined
VOICE_RECONNECT_GRACE_S=20       # keep finishing the turn this long after the browser disconnects
CORS_ORIGINS=                    # comma-separated; empty = same-origin only

# --- Semantic cache (only clean, cited, standalone answers are stored) ------------
CACHE_ENABLED=true
CACHE_SIMILARITY=0.96

# Postgres container credentials (docker-compose only) — change them for any shared host.
POSTGRES_USER=bhasha
POSTGRES_PASSWORD=bhasha
POSTGRES_DB=bhasha

# Graph is additive (C11) — start it with `docker compose --profile graph up -d neo4j`.
GRAPH_PROVIDER=none               # neo4j_local | neo4j_aura | none
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bhasha_graph_pw
GRAPH_MAX_HOPS=2
GRAPH_TIMEOUT_S=2.0
GRAPH_TRIGGER_TYPES=multi_hop,comparative

# Frontend build-time options (web/.env): VITE_OFFLINE_MAP=1 skips online map tiles.
