# Copy to .env ON THE SERVER and fill in. Never commit the real file (C4).
BHASHA_PROFILE=cloud
DOMAIN=bhasha.example.duckdns.org        # the domain that points at this VM

POSTGRES_PASSWORD=change-me-long-random
LIVEKIT_API_KEY=change-me-key
LIVEKIT_API_SECRET=change-me-at-least-32-random-characters

GROQ_API_KEY=
SARVAM_API_KEY=
COHERE_API_KEY=

GRAPH_PROVIDER=none
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_AGENTS=3                  # simultaneous voice sessions the free APIs can sustain
